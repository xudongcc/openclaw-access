{$PUBLIC_URL} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		propagation_delay 5s
		resolvers 173.245.59.96 172.64.33.96
	}

	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {$PUBLIC_SCHEME}
			header_up X-Forwarded-Uri {uri}
		}
	}

	handle {
		route {
			request_header -X-Auth-Request-User
			request_header -X-Auth-Request-Email
			request_header -X-OpenClaw-Scopes

			forward_auth oauth2-proxy:4180 {
				uri /oauth2/auth
				header_up X-Real-IP {client_ip}
				header_up X-Forwarded-For {client_ip}
				header_up X-Forwarded-Proto {$PUBLIC_SCHEME}
				copy_headers X-Auth-Request-User X-Auth-Request-Email

				@unauthorized status 401
				handle_response @unauthorized {
					redir * /oauth2/sign_in?rd={$PUBLIC_URL}{uri}
				}
			}

			request_header X-OpenClaw-Scopes "operator.read,operator.write,operator.approvals,operator.questions"
			@admin header X-Auth-Request-Email {$OPENCLAW_ADMIN_EMAIL}
			request_header @admin X-OpenClaw-Scopes "operator.admin,operator.read,operator.write,operator.approvals,operator.questions,operator.pairing,operator.talk.secrets"

			reverse_proxy {$OPENCLAW_URL} {
				header_up X-Real-IP {client_ip}
				header_up X-Forwarded-For {client_ip}
				header_up X-Forwarded-Proto {$PUBLIC_SCHEME}
			}
		}
	}
}

{$SANDBOX_PUBLIC_URL} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		propagation_delay 5s
		resolvers 173.245.59.96 172.64.33.96
	}

	reverse_proxy {$OPENCLAW_SANDBOX_URL} {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {$PUBLIC_SCHEME}
	}
}

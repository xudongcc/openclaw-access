(cloudflare_tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		propagation_delay 5s
		resolvers 173.245.59.96 172.64.33.96
	}
}

claw.kudeploy.com {
	import cloudflare_tls

	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	handle {
		route {
			request_header -X-Auth-Request-User
			request_header -X-Auth-Request-Email
			request_header -X-OpenClaw-Scopes

			forward_auth oauth2-proxy:4180 {
				uri /oauth2/auth
				copy_headers X-Auth-Request-Email

				@unauthorized status 401
				handle_response @unauthorized {
					redir * /oauth2/sign_in?rd=https://claw.kudeploy.com{uri}
				}
			}

			reverse_proxy host.docker.internal:18789
		}
	}
}

claw-artifacts.kudeploy.com {
	import cloudflare_tls
	reverse_proxy host.docker.internal:18790
}

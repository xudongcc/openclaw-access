# GitHub OAuth App credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# Cloudflare API token scoped to kudeploy.com with Zone:Read and DNS:Edit.
CLOUDFLARE_API_TOKEN=

# GitHub access policy. Members of this organization are allowed.
GITHUB_ORG=kudeploy

# GitHub OAuth App credentials.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# Cloudflare API token scoped to kudeploy.com with Zone:Read and DNS:Edit.
CLOUDFLARE_API_TOKEN=

# GitHub access policy. Members of this organization are allowed; listed users
# are also allowed even when they are not organization members.
GITHUB_ORG=Kudeploy
GITHUB_USERS=xudongcc

# This must exactly match the GitHub OAuth App callback URL.
OAUTH2_PROXY_REDIRECT_URL=https://claw.kudeploy.com/oauth2/callback
OAUTH2_PROXY_WHITELIST_DOMAIN=claw.kudeploy.com
OAUTH2_PROXY_COOKIE_SECURE=true

# Public LAN URL information.
PUBLIC_URL=https://claw.kudeploy.com
SANDBOX_PUBLIC_URL=https://claw-artifacts.kudeploy.com
PUBLIC_SCHEME=https

# Local listener and private Compose network. Change the subnet only when it
# conflicts with another Docker network; keep the gateway and static addresses
# inside the selected subnet.
ACCESS_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
ACCESS_SUBNET=172.31.250.0/24
ACCESS_GATEWAY=172.31.250.1
OAUTH2_PROXY_IP=172.31.250.2
CADDY_IP=172.31.250.3

# OpenClaw gateway upstream as seen from the Caddy container.
OPENCLAW_URL=http://host.docker.internal:18789
OPENCLAW_SANDBOX_URL=http://host.docker.internal:18790

# This identity receives the administrator scope cap. Other authenticated
# organization members receive read/write/approval/question scopes.
OPENCLAW_ADMIN_EMAIL=me@huangxudong.com
